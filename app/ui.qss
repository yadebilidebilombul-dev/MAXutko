QWidget {
    background: #0b1220;
    color: #e5e7eb;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow, QStackedWidget {
    background: #0b1220;
}

#loginCard {
    background: #111827;
    border: 1px solid #1f2937;
    border-radius: 12px;
}

#titleLabel {
    color: #38bdf8;
}

#topBar {
    background: #0f172a;
    border: 1px solid #111827;
    border-radius: 10px;
}

QLineEdit, QTextEdit {
    color: #e5e7eb;
    background: #0f172a;
    border: 1px solid #1f2937;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #38bdf8;
}

#inputArea {
    min-height: 48px;
    max-height: 48px;
}

QPushButton#primaryButton {
    background: #38bdf8;
    color: #0b1220;
    border-radius: 8px;
    padding: 8px 18px;
}

QPushButton#primaryButton:hover {
    background: #7dd3fc;
}

QPushButton#ghostButton {
    background: #0b1220;
    color: #e5e7eb;
    border: 1px solid #1f2937;
    border-radius: 8px;
    padding: 6px 14px;
}

QPushButton#ghostButton:hover {
    background: #111827;
}

QPushButton#dangerButton {
    background: #ef4444;
    color: #ffffff;
    border-radius: 8px;
    padding: 6px 14px;
}

QPushButton#dangerButton:hover {
    background: #f87171;
}

QRadioButton {
    spacing: 8px;
    color: #e5e7eb;
}

QScrollArea {
    border: none;
    background: #0b1220;
}
QScrollArea::viewport {
    background: #0b1220;
}

#messagesContainer {
    background: #0b1220;
}

#usersPanel {
    background: #0f172a;
    border: 1px solid #111827;
    border-radius: 10px;
}

#usersTitle {
    color: #e5e7eb;
    font-weight: 600;
}

#usersList {
    background: transparent;
    border: none;
    outline: none;
}

#usersList::item {
    padding: 4px 2px;
}

#usersList::item:selected {
    background: transparent;
}

#userRow {
    background: transparent;
}

#userNameActive {
    color: #22c55e;
}

#userNameInactive {
    color: #94a3b8;
}

#unreadBadge {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0px;
    border-radius: 10px;
    margin: 0px;
    background: #38bdf8;
    color: #0b1220;
    font-weight: 600;
    qproperty-alignment: 'AlignCenter';
}

#messageMe {
    background: #1d4ed8;
    border-radius: 12px;
    padding: 8px 10px;
}

#messageOther {
    background: #1f2937;
    border-radius: 12px;
    padding: 8px 10px;
}

#messageSystem {
    background: #334155;
    border-radius: 10px;
    padding: 6px 10px;
}

#messageMe QLabel,
#messageOther QLabel,
#messageSystem QLabel {
    background: transparent;
    color: #e5e7eb;
}

#statusLabel {
    color: #38bdf8;
}

#mutedLabel {
    color: #94a3b8;
}
QLineEdit::placeholder {
    color: #94a3b8;
}

QPushButton {
    color: #e5e7eb;
}
