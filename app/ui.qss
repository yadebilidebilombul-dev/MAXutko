QWidget {
    background: #f3f4f6;
    color: #111827;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow, QStackedWidget {
    background: #f3f4f6;
}

#loginCard {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
}

#titleLabel {
    color: #2563eb;
}

#topBar {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}

#selfAvatar {
    background: #ffffff;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
}

#userNameLabel {
    color: #111827;
    font-weight: 600;
}

#userMetaLabel {
    color: #6b7280;
    font-size: 9pt;
}

#clanPrimaryLabel {
    color: #1d4ed8;
    background: #dbeafe;
    border-radius: 8px;
    padding: 2px 8px;
    font-weight: 600;
    font-size: 10.5pt;
}

#clanDotLabel {
    color: #9ca3af;
    font-weight: 700;
}

#clanSecondaryLabel {
    color: #6b7280;
    background: #e5e7eb;
    border-radius: 8px;
    padding: 2px 8px;
    font-weight: 600;
    font-size: 9pt;
}

#chatTitle {
    color: #111827;
    font-weight: 600;
}

QLineEdit, QTextEdit {
    color: #111827;
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px 10px;
}

#inputArea {
    min-height: 46px;
    max-height: 46px;
}

QPushButton#primaryButton {
    background: #2563eb;
    color: #ffffff;
    border-radius: 10px;
    padding: 8px 18px;
}

QPushButton#primaryButton:hover {
    background: #1d4ed8;
}

QPushButton#ghostButton {
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 6px 14px;
}

QPushButton#ghostButton:hover {
    background: #f3f4f6;
}

QPushButton#dangerButton {
    background: #ef4444;
    color: #ffffff;
    border-radius: 10px;
    padding: 6px 14px;
}

QPushButton#dangerButton:hover {
    background: #dc2626;
}

QRadioButton {
    spacing: 8px;
    color: #374151;
}

QScrollArea {
    border: none;
    background: #f3f4f6;
}

#messagesContainer {
    background: #f3f4f6;
}

#usersPanel {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}

#usersTitle {
    color: #111827;
    font-weight: 600;
}

#usersList {
    background: transparent;
    border: none;
    outline: none;
}

#usersList::item {
    padding: 2px 2px;
}

#usersList::item:selected {
    background: transparent;
}

#userRow {
    background: transparent;
    border-radius: 10px;
}

#userRow[selected="true"] {
    background: #dbeafe;
    border: 1px solid #bfdbfe;
}

#userRow[selected="true"] QLabel {
    color: #1d4ed8;
}

#userAvatar {
    background: transparent;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
    border-radius: 13px;
    font-weight: 600;
    padding: 0px;
    margin-top: -2px;
}

#userNameActive {
    color: #111827;
}

#userNameInactive {
    color: #6b7280;
}

#unreadBadge {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0px;
    border-radius: 10px;
    margin: 0px;
    background: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

#messageMe {
    background: #2563eb;
    border-radius: 14px;
    padding: 8px 12px;
}

#messageOther {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 8px 12px;
}

#messageSystem {
    background: #e5e7eb;
    border-radius: 12px;
    padding: 6px 10px;
}

#messageMe QLabel,
#messageOther QLabel,
#messageSystem QLabel {
    background: transparent;
    color: #111827;
}

#messageMe QLabel {
    color: #ffffff;
}

#replyBar {
    background: #ffffff;
    border: 1px solid #dbeafe;
    border-radius: 10px;
}

#replyMeta {
    color: #2563eb;
    font-size: 9pt;
    font-weight: 600;
}

#replyBody {
    color: #6b7280;
    font-size: 9pt;
}

#replyPreview {
    background: #eef2ff;
    border-left: 3px solid #2563eb;
    border-radius: 10px;
}

#replyPreview QLabel {
    background: transparent;
}

#messageMe #replyPreview {
    background: #1e3a8a;
    border-left: 3px solid #93c5fd;
}

#messageMe #replyPreview QLabel {
    color: #e0e7ff;
}

#statusLabel {
    color: #2563eb;
}

#linkLabel {
    color: #2563eb;
    font-size: 9pt;
}

#linkLabel:hover {
    color: #1d4ed8;
}

#mutedLabel {
    color: #6b7280;
}

QPushButton {
    color: #111827;
}
